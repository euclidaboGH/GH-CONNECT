# GreenHaven / GH-CONNECT — environment template (placeholders only)
# Copy to .env.local and fill server-side values in the host environment.
# Never commit real secrets. Private credentials must NOT use NEXT_PUBLIC_.
# Values in this template must remain empty, 0, or 1 for source hygiene checks.

# --- Public client (set in deployment env; leave empty here) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PI_SANDBOX=

# --- Server only (never NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Pi Network server API (server-only)
PI_API_KEY=
PI_SERVER_API_KEY=

# Operator / reconcile (server-only)
GHC_OPERATOR_RECONCILE_KEY=
GHC_A2U_ADMIN_KEY=
GHC_CREATOR_REWARD_OPERATOR_KEY=
GHC_SETTLEMENT_OPERATOR_KEY=

# Feature flags (safe defaults)
GHC_REFERRAL_SETTLEMENT_ENABLED=0
GHC_CURATION_REDISTRIBUTE_ENABLED=0
GHC_CURATION_REDISTRIBUTION_ENABLED=0

# E2E / operator probes (Testnet only; configure outside the template)
GHC_E2E_ALLOW_TESTNET=0

# Registration bonus policy is 3 PI total (atomic 30000000). Legacy 0.05 PI claimants top-up 2.95 PI.
# Phase 1 registration bonus (Testnet): 3 π new / 2.95 π top-up for verified 0.05 π v1 claimants.
# Apply migration 20261030010001_registration_bonus_v2_reconciliation.sql before enabling.
# One-time PI registration bonus (3 π total; 2.95 π legacy top-up).
# Enable only in the Testnet deployment with NEXT_PUBLIC_PI_SANDBOX=.
GHC_REGISTRATION_BONUS_ENABLED=0

# PI earnings user payout requests (durable request only; not a transfer)
# Phase 4 — durable payout request intake (Testnet). Requires linked KYC Pi identity + funded A2U for execution.
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=0
# PI_NETWORK must be set in deployment (testnet|mainnet). Leave unset in example.
# PI_NETWORK=

# Phase 4 execution worker (operator/service only — never client-callable without secret)
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
PI_A2U_ENABLED=0
PI_A2U_TESTNET_ONLY=1
