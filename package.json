{
  "name": "gh-connect",
  "version": "0.59.5",
  "private": true,
  "description": "GreenHaven \u2014 social, matching, community, messaging, marketplace and GHC utility platform",
  "scripts": {
    "dev": "next dev",
    "build": "ESLINT_USE_FLAT_CONFIG=false next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "typecheck": "tsc --noEmit",
    "vercel-build": "npm run build",
    "ci": "npm ci --legacy-peer-deps",
    "check:jsx": "node scripts/check-jsx-safety.mjs",
    "prebuild": "node scripts/check-jsx-safety.mjs",
    "test:economy": "node scripts/test-economy-v12.mjs",
    "test:daily-wallet": "node scripts/test-daily-claim-wallet-pipeline.mjs",
    "test:release": "node scripts/verify-production-release.mjs",
    "test:safety": "node scripts/scan-production-safety.mjs",
    "ci:verify": "npm run typecheck && npm run lint && npm run test:safety && npm run test:rewards-reliability && npm run test:engagement-rosters && npm run test:stories && npm run test:post-composer && npm run test:social-messaging && npm run test:messaging-reliability && npm run build",
    "test:idor-checklist": "node scripts/test-idor-isolation.mjs",
    "ops:migration-check": "node scripts/print-migration-checklist.mjs",
    "verify:static": "node scripts/verify-phase14-static.mjs",
    "verify:migrations": "node scripts/print-migration-checklist.mjs",
    "test:social-authz": "node scripts/test-social-authz.mjs",
    "test:idor-static": "node scripts/test-idor-static.mjs",
    "audit:profile": "node scripts/audit-profile-production.mjs",
    "audit:profile-connected": "node scripts/audit-profile-connected-production.mjs",
    "audit:profile-connected-v2": "node scripts/audit-profile-connected-v2.mjs",
    "operator:multiuser-migrations": "node scripts/operator-multiuser-migrations.mjs",
    "operator:live-e2e": "node scripts/operator-live-e2e.mjs",
    "operator:infra": "node scripts/operator-multiuser-migrations.mjs && node scripts/print-migration-checklist.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:prod": "node -e \"if(process.env.GHC_E2E_ALLOW_PRODUCTION!=='1'){console.error('Set GHC_E2E_ALLOW_PRODUCTION=1');process.exit(2)}\" && playwright test --project=chromium",
    "test:e2e:validate": "node -e \"import('./lib/e2e/resolve-base-url.mjs').then(m=>m.requireE2eBaseUrl())\"",
    "operator:live-e2e-social": "node scripts/operator-live-e2e-social.mjs",
    "operator:verify-migration-defs": "node scripts/operator-verify-migration-defs.mjs",
    "test:engagement-rosters": "node scripts/test-engagement-roster-security.mjs",
    "test:stories": "node scripts/test-story-creator.mjs",
    "test:post-composer": "node scripts/test-post-composer.mjs",
    "test:social-messaging": "node scripts/test-social-messaging-upgrade.mjs",
    "test:messaging-reliability": "node scripts/test-messaging-reliability.mjs",
    "test:rewards-reliability": "node scripts/test-rewards-reliability.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.2.2",
    "@simplewebauthn/server": "13.2.2",
    "@swetate/auth": "^0.1.0",
    "@swetate/core": "^0.1.0",
    "@swetate/user-state": "^0.1.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "geist": "^1.3.1",
    "isomorphic-dompurify": "3.20.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "15.5.26",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.15.0",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
