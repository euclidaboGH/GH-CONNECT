{
  "name": "gh-connect",
  "version": "0.145.1",
  "private": true,
  "description": "GreenHaven \u2014 social, matching, community, messaging, marketplace and GHC utility platform",
  "scripts": {
    "dev": "next dev",
    "build": "ESLINT_USE_FLAT_CONFIG=false next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --max-warnings 9999",
    "typecheck": "tsc --noEmit",
    "vercel-build": "npm run build",
    "prebuild": "node scripts/check-node-runtime.mjs && node scripts/check-jsx-safety.mjs",
    "pretypecheck": "node scripts/check-node-runtime.mjs",
    "prelint": "node scripts/check-node-runtime.mjs",
    "check:jsx": "node scripts/check-jsx-safety.mjs",
    "check:runtime": "node scripts/check-node-runtime.mjs",
    "verify:static": "node scripts/verify-phase14-static.mjs",
    "check:phase15-payment-recovery": "node scripts/check-phase15-payment-recovery.mjs",
    "check:phase14-reconciliation": "node scripts/check-phase14-reconciliation-efficiency.mjs",
    "verify:migrations": "node scripts/print-migration-checklist.mjs",
    "ops:migration-check": "node scripts/print-migration-checklist.mjs",
    "test:safety": "node scripts/scan-production-safety.mjs",
    "check:release-hygiene": "node scripts/check-release-hygiene.mjs",
    "check:dependency-lock-integrity": "node scripts/check-dependency-lock-integrity.mjs",
    "check:pi-backend-lock": "node scripts/verify-pi-backend-lock.mjs",
    "check:project-truth": "node scripts/check-project-truth.mjs",
    "check:phase31": "node scripts/check-phase31-floating-header-settlement.mjs",
    "check:phase2-identity": "node scripts/check-phase2-canonical-identity.mjs",
    "check:clean-migrations": "node scripts/check-clean-migrations.mjs",
    "check:database-contract-source": "node scripts/check-database-contract-source.mjs",
    "check:migration-release-readiness": "node scripts/check-migration-release-readiness.mjs",
    "check:migration-inventory": "node scripts/generate-migration-inventory.mjs --check",
    "operator:live-e2e": "node scripts/operator-live-e2e.mjs",
    "operator:infra": "node scripts/operator-multiuser-migrations.mjs && node scripts/print-migration-checklist.mjs",
    "check:phase3-profile-identity": "node scripts/check-phase3-profile-identity.mjs",
    "check:phase4-identity-integration": "node scripts/check-phase4-identity-integration.mjs",
    "check:phase5-reliability": "node scripts/check-phase5-reliability.mjs",
    "check:phase6-integration": "node scripts/check-phase6-integration-reliability.mjs",
    "check:phase7-runtime-hardening": "node scripts/check-phase7-runtime-hardening.mjs",
    "operator:phase7-runtime-hardening": "node scripts/operator-phase7-runtime-hardening.mjs",
    "check:phase8-wallet-history": "node scripts/check-phase8-wallet-history-foundation.mjs",
    "check:phase9-wallet-transactions": "node scripts/check-phase9-wallet-transaction-integration.mjs",
    "check:phase16-payment-timeline": "node scripts/check-phase16-payment-timeline.mjs",
    "verify:legal": "node scripts/verify-legal-public.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.2.2",
    "@simplewebauthn/server": "13.2.2",
    "@swetate/auth": "^0.1.0",
    "@swetate/core": "^0.1.0",
    "@swetate/user-state": "^0.1.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "geist": "^1.3.1",
    "isomorphic-dompurify": "3.20.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.67",
    "pi-backend": "0.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "15.5.26",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.15.0",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
