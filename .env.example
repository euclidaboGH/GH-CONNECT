# GreenHaven local-development template. Copy to .env.local and fill values locally.
# Never commit real credentials. Empty values below are intentional placeholders.

# Public Supabase settings (the anon key is designed for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credentials. Never prefix privileged keys with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pi Testnet application settings. Keep all server credentials private.
PI_NETWORK=
PI_ENV=
NEXT_PUBLIC_PI_SANDBOX=true
PI_API_KEY=
PI_WALLET_PRIVATE_SEED=

# Required server-side proof secret; generate a cryptographically random value locally.
GH_PIN_PROOF_SECRET=

# Supabase Storage bucket name.
GH_MEDIA_BUCKET=

# Optional Testnet-only payout controls. Keep disabled until operator reconciliation
# of the Pi incomplete-payment lane and wallet funding verification are complete.
PI_A2U_ENABLED=0
PI_A2U_TESTNET_ONLY=true
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=0
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
PI_EARNINGS_AUTO_EXECUTE=false

# Optional registration reward issuance remains off unless explicitly enabled on Pi sandbox.
GHC_REGISTRATION_BONUS_ENABLED=0

# Real-user performance telemetry is opt-in and off by default.
NEXT_PUBLIC_RUM_SAMPLE_RATE=0

# Direct voice/video calls (Testnet). Keep disabled until TURN is configured.
# GH_CALL_TURN_URLS accepts comma-separated turn: or turns: URLs.
# GH_CALL_STUN_URLS accepts comma-separated stun: URLs.
# GH_CALL_TURN_SHARED_SECRET must match the coturn REST API shared secret.
GH_CALLS_ENABLED=false
GH_CALL_STUN_URLS=
GH_CALL_TURN_URLS=
GH_CALL_TURN_SHARED_SECRET=

# Creator reward pool operator secret. Server-only; never prefix with NEXT_PUBLIC_.
# Generate a random secret of at least 32 bytes and configure it only in trusted
# server environments. Leave empty to keep creator reward funding/settlement disabled.
GHC_CREATOR_REWARD_OPERATOR_KEY=
