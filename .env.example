# GreenHaven / GH-CONNECT — environment variable template
# Copy values into Vercel (Production vs Preview). Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=https://gh-connect-tau.vercel.app

# --- Pi (client-safe) ---
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=false
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=gh-connect-tau.vercel.app
NEXT_PUBLIC_REQUIRE_PI_BROWSER=

# --- Pi (server-only — never NEXT_PUBLIC_) ---
PI_API_KEY=
# Optional alias:
# PI_SERVER_API_KEY=

# --- Domain validation (public body at /validation-key.txt; set per domain) ---
DOMAIN_VALIDATION_KEY=

# --- Supabase ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional:
# DATABASE_URL=
# SUPABASE_JWT_SECRET=

# --- Optional security ---
# GHC_AUTH_JWT_SECRET=
# GHC_ALLOW_DEV_AUTH=0
# GHC_SERVER_MEMORY=0

# Preview / Testnet example (set on Vercel Preview only):
# NEXT_PUBLIC_APP_URL=https://gh-connect-5p3o.vercel.app
# NEXT_PUBLIC_PI_SANDBOX=true
# NEXT_PUBLIC_PI_CLIENT_ID=<Testnet Client ID>
# PI_API_KEY=<Testnet API key>
# SUPABASE_URL=<Testnet project>
# SUPABASE_SERVICE_ROLE_KEY=<Testnet service role>
# DOMAIN_VALIDATION_KEY=<Testnet domain key if required>
