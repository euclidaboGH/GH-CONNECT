# GREENHAVEN local development environment template.
# All secrets are intentionally blank. Never commit populated local .env files.

# Public application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_PI_SANDBOX=true
NEXT_PUBLIC_RUM_SAMPLE_RATE=0

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=

# Server-only security and scheduling secrets
CRON_SECRET=
GHC_AUTH_JWT_SECRET=
GHC_PIN_PROOF_SECRET=
GH_PIN_PROOF_SECRET=
WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Optional Pi Testnet integration; execution stays disabled by default.
# PI_ENV selects the Pi Platform app mode; PI_NETWORK selects the blockchain network.
# For Testnet, keep the SDK in sandbox while using the production Platform API mode.
PI_ENV=production
PI_NETWORK=testnet
PI_A2U_TESTNET_ONLY=true
PI_A2U_ENABLED=0
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=0
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
PI_SERVER_API_KEY=
PI_API_KEY=
PI_WALLET_PRIVATE_SEED=
PI_EARNINGS_EXECUTOR_KEY=

# Optional server-side payment provider configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_LIVE_TRANSFERS_APPROVED=false

# One-time registration bonus; explicitly disabled until separately approved
GHC_REGISTRATION_BONUS_ENABLED=0

# Required for timed examination respondent-key hashing; use a unique random secret of at least 32 characters.
RESEARCH_EXAM_HASH_SECRET=
