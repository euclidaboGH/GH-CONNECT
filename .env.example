# GreenHaven / GH-CONNECT — environment template (placeholders only)
# Copy to .env.local for local work. Never commit real secrets.
# Private credentials must NOT use the NEXT_PUBLIC_ prefix.

# --- Public client ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PI_SANDBOX=true

# --- Server only (never NEXT_PUBLIC_) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=

# Pi Network server API (server-only)
PI_API_KEY=
PI_SERVER_API_KEY=
# PI_WALLET_PRIVATE_SEED=   # never put in NEXT_PUBLIC_*

# Operator / reconcile (server-only)
GHC_OPERATOR_RECONCILE_KEY=
GHC_A2U_ADMIN_KEY=

# Feature flags (safe defaults)
GHC_REFERRAL_SETTLEMENT_ENABLED=0
GHC_CURATION_REDISTRIBUTION_ENABLED=0

# E2E / operator probes (Testnet only; never point at production without review)
# GHC_E2E_BASE_URL=
# GHC_E2E_ALLOW_TESTNET=1
