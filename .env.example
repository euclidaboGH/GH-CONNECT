# GreenHaven / GH-CONNECT — environment variable template
# Copy into Vercel (Production vs Preview). Never commit real secrets.

# ========== PUBLIC CONFIG ==========
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ========== PI CLIENT / APP CONFIG ==========
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=false
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=your-app.vercel.app
NEXT_PUBLIC_REQUIRE_PI_BROWSER=

# ========== SUPABASE PUBLIC CONFIG ==========
NEXT_PUBLIC_SUPABASE_URL=

# ========== SERVER-ONLY SECRETS ==========
# Pi (server-only — never NEXT_PUBLIC_)
PI_API_KEY=
# Optional alias: PI_SERVER_API_KEY=

# Supabase service role (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: DATABASE_URL=  SUPABASE_JWT_SECRET=

# ========== AUTH SECRETS ==========
# GHC_AUTH_JWT_SECRET=
DOMAIN_VALIDATION_KEY=

# ========== OPTIONAL REALTIME CONFIG ==========
# Real WebSocket backend only — do not invent a local /realtime path
# NEXT_PUBLIC_GH_REALTIME_URL=wss://realtime.example.com/v1
# GHC_REALTIME_CONFIGURED=0

# ========== FEATURE FLAGS ==========
# GHC_ALLOW_DEV_AUTH=0
# GHC_SERVER_MEMORY=0
# NEXT_PUBLIC_MESSAGING_DURABLE=1
# Production marketplace concurrent stock: enable only after reserve RPC is applied
# GH_MARKETPLACE_ATOMIC_RESERVE=0

# ========== MARKETPLACE / PAYMENT PROVIDERS ==========
# GH_MEDIA_BUCKET=gh-media
# PI platform URL is resolved in code; no extra public payment secrets on client

# Preview / Testnet example (Vercel Preview only):
# NEXT_PUBLIC_APP_URL=https://your-preview.vercel.app
# NEXT_PUBLIC_PI_SANDBOX=true
# NEXT_PUBLIC_PI_CLIENT_ID=<Testnet Client ID>
# PI_API_KEY=<Testnet API key>
# SUPABASE_URL=<Testnet project>
# SUPABASE_SERVICE_ROLE_KEY=<Testnet service role>
