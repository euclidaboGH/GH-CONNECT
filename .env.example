# GreenHaven local template only. Never paste production secrets into this file.
# Configure Vercel Preview and Production separately. Use separate Supabase projects,
# Pi network credentials, validation keys, and host allowlists for Testnet and Mainnet.

# App origins and public client configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_GHC_API_URL=http://localhost:3000
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=true
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_VERCEL_ENV=development
NEXT_PUBLIC_GH_REALTIME_URL=
NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost
NEXT_PUBLIC_REQUIRE_PI_BROWSER=false
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=false
NEXT_PUBLIC_DISCOVERY_DEMO=false
NEXT_PUBLIC_GHC_STUDIO=false
NEXT_PUBLIC_MESSAGING_DURABLE=true

# Server-side Supabase credentials (never use NEXT_PUBLIC_ for these)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# Pi Platform credentials. Keep server-side secrets server-only.
PI_API_KEY=
PI_SERVER_API_KEY=
PI_API_URL=https://api.minepi.com
PI_PLATFORM_API_URL=https://api.minepi.com
PI_ALLOW_UNBOUND_APPROVE=false
PI_STAKING_API_ENABLED=false
PI_WALLET_PRIVATE_SEED=
GHC_BUY_WITH_PI_ENABLED=false

# GreenHaven internal/service controls. Set real values only in secret manager.
GHC_ENV=development
GHC_API_URL=http://localhost:3000
GHC_AUTH_JWT_SECRET=
GHC_A2U_ADMIN_KEY=
GHC_A2U_ALLOW_PARTIAL=false
GHC_ADMIN_CREDIT_KEY=
GHC_ALLOW_DEV_AUTH=false
GHC_ALLOW_ELIGIBLE_OVERRIDE=false
GHC_ELIGIBLE_ECONOMIC_USERS=
GHC_GOVERNANCE_SERVER=
GHC_MARKETPLACE_LISTING_FEE_BPS=0
GHC_MARKETPLACE_LISTING_FEE_PI=0
GHC_REALTIME_CONFIGURED=false
GHC_REPUTATION_SERVER=
GHC_SERVER_MEMORY=false
GHC_VERIFICATION_SERVER=
GHC_WITHDRAWAL_GHC_PER_PI=0
GH_ADS_ENABLED=false
GH_MARKETPLACE_ATOMIC_RESERVE=false
GH_MEDIA_BUCKET=
GH_SETTLEMENT_INTERNAL_KEY=
GH_WITHDRAWAL_OPERATOR_IDS=
DOMAIN_VALIDATION_KEY=
VERIFICATION_REVIEW_SECRET=
WEBAUTHN_ENABLED=false
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=GreenHaven Local

# Optional operator smoke-test inputs; never commit actual session cookies/tokens.
