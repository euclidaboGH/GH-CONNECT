# GreenHaven local environment template
# Copy to .env.local and fill only the values required for your environment.
# Never commit .env.local or paste production secrets into this file.

# Public application URLs (safe to expose in the browser)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_PI_CLIENT_ID=

# Server-only Supabase configuration — do not prefix secrets with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pi Platform server integration — server-only
PI_API_URL=
PI_SERVER_API_KEY=
PI_ENV=
PI_NETWORK=

# Optional server configuration
GH_MEDIA_BUCKET=
CRON_SECRET=

# Explicitly fail-closed feature defaults; enable only after operator approval.
NEXT_PUBLIC_RUM_SAMPLE_RATE=0
GHC_REGISTRATION_BONUS_ENABLED=0
GHC_REFERRAL_SETTLEMENT_ENABLED=0
GHC_CURATION_REDISTRIBUTE_ENABLED=0
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=0
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
PI_A2U_ENABLED=0
PI_A2U_TESTNET_ONLY=true
GH_PIN_PROOF_SECRET=
# PI_NETWORK must be set in deployment (testnet for Testnet-only operations).
PI_NETWORK=
