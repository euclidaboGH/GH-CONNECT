# GreenHaven local environment template.
# Keep every secret empty in this committed example. Configure real values only in the deployment secret manager.

# Public application and Pi platform settings
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GHC_API_URL=
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=1
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=
NEXT_PUBLIC_REQUIRE_PI_BROWSER=1
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=0
NEXT_PUBLIC_DISCOVERY_DEMO=0
NEXT_PUBLIC_GHC_STUDIO=0
NEXT_PUBLIC_MESSAGING_DURABLE=1
NEXT_PUBLIC_GH_REALTIME_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_WEBAUTHN_RP_ID=

# Server-side Supabase and authentication
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
DATABASE_URL=
SUPABASE_JWT_SECRET=

# Standards-based Web Push (VAPID). Keep the private key and subscription encryption key server-only; sender remains disabled until provider implementation and acceptance.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# Generate 32 random bytes and base64url-encode them. Keep server-only.
WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=
GHC_AUTH_JWT_SECRET=
GHC_AUTH_JWT_ISSUER=
GHC_AUTH_JWT_AUDIENCE=
GHC_ALLOW_DEV_AUTH=0
GHC_ENV=

# Pi platform integration
PI_PLATFORM_API_URL=
PI_API_URL=
PI_API_KEY=
PI_SERVER_API_KEY=
PI_NETWORK=
PI_ENV=
PI_WALLET_PRIVATE_SEED=
PI_ALLOW_UNBOUND_APPROVE=0

# Financial operators and feature gates — disabled unless explicitly approved
PI_A2U_ENABLED=0
PI_A2U_TESTNET_ONLY=1
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=0
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
PI_EARNINGS_EXECUTOR_KEY=
PI_EARNINGS_ADAPTERS_ENABLED=0
PI_STAKING_API_ENABLED=0
GHC_WITHDRAWALS_ENABLED=0
GHC_TIPS_ENABLED=0
GHC_REFERRAL_SETTLEMENT_ENABLED=0
