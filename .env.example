# GreenHaven local template only. Never paste production secrets into this file.
# Configure Vercel Preview and Production separately. Use separate Supabase projects,
# Pi network credentials, validation keys, and host allowlists for Testnet and Mainnet.

# App origins and public client configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_GHC_API_URL=http://localhost:3000
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=true
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_VERCEL_ENV=development
NEXT_PUBLIC_GH_REALTIME_URL=
NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost
NEXT_PUBLIC_REQUIRE_PI_BROWSER=false
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=false
NEXT_PUBLIC_DISCOVERY_DEMO=false
NEXT_PUBLIC_GHC_STUDIO=false
# Keep durable messaging disabled until Testnet migration + two-user IDOR/E2E gates pass.
NEXT_PUBLIC_MESSAGING_DURABLE=false

# Server-side Supabase credentials (never use NEXT_PUBLIC_ for these)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# Pi Platform credentials. Keep server-side secrets server-only.
PI_API_KEY=
PI_SERVER_API_KEY=
PI_API_URL=https://api.minepi.com
PI_PLATFORM_API_URL=https://api.minepi.com
PI_ALLOW_UNBOUND_APPROVE=false
PI_STAKING_API_ENABLED=false
PI_WALLET_PRIVATE_SEED=
# Official pi-backend configuration bundle. This does not select Mainnet for payouts.
PI_ENV=production
PI_A2U_ENABLED=false
PI_A2U_TESTNET_ONLY=true
GHC_BUY_WITH_PI_ENABLED=false

# GreenHaven internal/service controls. Set real values only in secret manager.
GHC_ENV=development
GHC_API_URL=http://localhost:3000
GHC_AUTH_JWT_SECRET=
# Optional additional JWT claim validation when your issuer/audience are stable.
GHC_AUTH_JWT_ISSUER=
GHC_AUTH_JWT_AUDIENCE=
GHC_A2U_ADMIN_KEY=
GHC_PAYOUT_RECONCILIATION_KEY=
GHC_MARKETPLACE_GHC_PAYOUTS_ENABLED=false
GHC_MARKETPLACE_PAYOUT_TREASURY_USER_ID=
GHC_ADMIN_CREDIT_KEY=
GHC_ALLOW_DEV_AUTH=false
GHC_ALLOW_ELIGIBLE_OVERRIDE=false
GHC_ELIGIBLE_ECONOMIC_USERS=
GHC_GOVERNANCE_SERVER=
GHC_MARKETPLACE_LISTING_FEE_BPS=0
GHC_MARKETPLACE_LISTING_FEE_GHC=0
GHC_MARKETPLACE_LISTING_FEE_PI=0
GHC_REALTIME_CONFIGURED=false
GHC_REPUTATION_SERVER=
GHC_SERVER_MEMORY=false
GHC_VERIFICATION_SERVER=
GHC_WITHDRAWAL_GHC_PER_PI=0
GH_ADS_ENABLED=false
GH_MARKETPLACE_ATOMIC_RESERVE=false
GH_MEDIA_BUCKET=
GH_SETTLEMENT_INTERNAL_KEY=
GH_WITHDRAWAL_OPERATOR_IDS=
DOMAIN_VALIDATION_KEY=
VERIFICATION_REVIEW_SECRET=
WEBAUTHN_ENABLED=false
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=GreenHaven Local

# Optional operator smoke-test inputs; never commit actual session cookies/tokens.
# GHC_E2E_BASE_URL=https://your-preview.vercel.app
# GHC_E2E_COOKIE_A=
# GHC_E2E_COOKIE_B=
# GHC_E2E_AUTH_A=
# GHC_E2E_AUTH_B=

# --- Stage 3–5 economy feature flags (default OFF / fail-closed) ---
# Referral ledger settlement (5% of charged VIP GHC). Requires migrations 202610181500–151.
GHC_REFERRAL_SETTLEMENT_ENABLED=0
# Balance-funded curation redistribution (debit voter → credit author). Requires 202610181502.
GHC_CURATION_REDISTRIBUTE_ENABLED=0
# Pilot fees — set to activate collection (ratesApproved). Display-only when unset.
# GHC_MARKETPLACE_LISTING_FEE_GHC=5
# GHC_MARKETPLACE_LISTING_FEE_PI=0.05
# GHC_COMMUNITY_CREATE_FEE_GHC=50
# GHC_COMMUNITY_CREATE_FEE_PI=0.5

# Optional: high-entropy server-only key for publishing global system announcements via /api/system/announcements. Never expose with NEXT_PUBLIC_.
GREENHAVEN_ANNOUNCEMENT_ADMIN_KEY=


# Privileged provider-verified PI seller payout reconciliation endpoint.
# Generate a high-entropy secret and store it only as a server-side Vercel environment variable.
# Never expose it with NEXT_PUBLIC_ and never commit the real value.
GHC_PAYOUT_RECONCILIATION_KEY=

# Keep false/unset until Phase 19 atomic GHC tip RPC passes Testnet concurrency gates.
GHC_TIPS_ENABLED=false
# Privileged creator reward pool operations; configure a long random secret only after Testnet verification.
GHC_CREATOR_REWARD_OPERATOR_KEY=

# Paystack NGN bank transfer adapter. Keep disabled until the Paystack account is approved
# for Transfers, webhook URL is configured, NGN funding obligations are sourced from a verified
# revenue/settlement path, and end-to-end Test Mode tests have passed. Server-side only.
PAYSTACK_SECRET_KEY=
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_LIVE_TRANSFERS_APPROVED=false
PAYSTACK_MAX_TRANSFER_KOBO=
PAYSTACK_DAILY_TRANSFER_LIMIT_KOBO=
GHC_BENEFICIARY_FINGERPRINT_KEY=

# Activity mission GHC (join community, first post, etc.). Default off until Testnet evidence.
GHC_ACTIVITY_REWARDS_ENABLED=0

# GHC-to-Pi withdrawals are disabled by default. Do not enable without separate product, legal, funding and release approval.
GHC_WITHDRAWALS_ENABLED=false

# --- Phase 1–4 economy (2026-10-21) ---
# Private server flags (Vercel: not NEXT_PUBLIC_)
GHC_TESTNET_UNLOCK=0
GHC_BUY_WITH_PI_ENABLED=false
GHC_ACTIVITY_REWARDS_ENABLED=0
GHC_PACK_MAX_PER_DAY=5
GHC_PACK_MAX_PER_WEEK=15
GHC_PACK_MAX_GHC_PER_DAY=1000
GHC_MARKETPLACE_PLATFORM_FEE_BPS=500
# Optional minimum marketplace commission in minor currency units; 0 means no floor.
GHC_MARKETPLACE_MIN_PLATFORM_FEE_MINOR=0
GHC_SELLER_PAYOUT_HOLD_DAYS=3
GHC_A2U_MAX_SINGLE_PI=100
GHC_ADMIN_API_KEY=
GHC_A2U_ADMIN_KEY=
# GHC_COMMUNITY_CREATE_FEE_GHC=5
# GHC_COMMUNITY_CREATE_FEE_PI=0.1

