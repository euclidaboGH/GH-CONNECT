# Copy to Vercel → Settings → Environment Variables.
# Never commit real secrets. Never put PI_API_KEY in client code.

# Pi Server API Key (Developer Portal → App → API Key) — SERVER ONLY
# Used for payments approve/complete. NEVER expose via NEXT_PUBLIC_*.
PI_API_KEY=

# Pi Sign-in OAuth Client ID (Developer Portal → Pi Sign-in → oAuth Client ID)
# Public identifier only — no client_secret exists for implicit flow.
NEXT_PUBLIC_PI_CLIENT_ID=

# Optional: force sandbox true/false. If unset, auto:
#   localhost + Vercel preview → sandbox true
#   Vercel production → sandbox false
# NEXT_PUBLIC_PI_SANDBOX=true

# Optional: public app origin (redirect URI base). If unset, uses window.location.origin.
# NEXT_PUBLIC_APP_URL=https://gh-connect-tau.vercel.app

# Optional: comma-separated hosts treated as production (sandbox false when env unset)
# NEXT_PUBLIC_PI_PRODUCTION_HOSTS=gh-connect-tau.vercel.app

# Domain validation (optional if public/validation-key.txt is deployed)
DOMAIN_VALIDATION_KEY=

# --- Authoritative GHC ledger ---
# Required on Vercel when Supabase/DATABASE_URL is not configured.
# Process memory store: spend/claim/transfer APIs work without a DB.
# Set to 0 only if you have SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL.
GHC_SERVER_MEMORY=1

# Optional privileged database (preferred when available)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# Dev-only Bearer user:<id> — never enable in production
# GHC_ALLOW_DEV_AUTH=1

# Optional JWT for first-party API auth (HS256)
# GHC_AUTH_JWT_SECRET=

# WebAuthn / Passkeys (Phase 7) — optional additive step-up
# Production MUST set exact RP ID and origin (no mixing preview/prod).
# WEBAUTHN_ENABLED=1
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGIN=https://app.example.com
# WEBAUTHN_RP_NAME=GreenHaven CONNECT
# NEXT_PUBLIC_APP_URL=https://app.example.com
# Set WEBAUTHN_ENABLED=0 to disable passkeys entirely.
