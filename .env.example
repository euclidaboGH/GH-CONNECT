# Safe environment template for GH Connect.
# Copy into a local .env.local and set values privately; never commit real secrets.
# Public browser variables must never contain service-role keys, Pi server keys, or payout secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PI_API_KEY=
PI_SERVER_API_KEY=
PI_WALLET_PRIVATE_SEED=
PAYSTACK_SECRET_KEY=

# Financial/economy feature gates. Keep OFF by default; enable only after approved Testnet evidence.
GHC_REFERRAL_SETTLEMENT_ENABLED=0
GHC_CURATION_REDISTRIBUTE_ENABLED=0
GHC_E2E_BASE_URL=
# Dedicated high-entropy secret (>=32 bytes) for GET /api/system/status diagnostics.
# Send as x-gh-system-status-key; never expose this value to browser/client code.
# Dedicated high-entropy operator secrets; keep server-side only (minimum 32 bytes).
GHC_CREATOR_REWARD_OPERATOR_KEY=
VERIFICATION_REVIEW_SECRET=
GH_SYSTEM_STATUS_OPERATOR_KEY=
