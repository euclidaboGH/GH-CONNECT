# Safe template only. Never commit real secrets or service-role keys.
# Copy to .env.local for local development and fill values privately.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — URL may be public; service-role key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_DB_URL=

# Pi Network integration — configure Testnet credentials in your secret store.
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=true
PI_API_KEY=
PI_PLATFORM_API_URL=https://api.minepi.com

# Optional first-party session signing secret. Use a strong random value privately.
GHC_AUTH_JWT_SECRET=

# Marketplace platform fee floor in minor currency units (0 means no minimum).
GHC_MARKETPLACE_MIN_PLATFORM_FEE_MINOR=0

# Optional WebAuthn configuration; leave disabled unless fully configured.
WEBAUTHN_ENABLED=0
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=GreenHaven CONNECT
