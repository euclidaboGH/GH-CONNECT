# GreenHaven (GH Connect) — copy to .env.local and fill in. NEVER commit real values.
# NEXT_PUBLIC_* is exposed to the browser: no secrets there.
# Same variable NAMES for Testnet and Mainnet; only the Vercel env VALUES differ.

# ── App / environment ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_VERCEL_ENV=
GHC_ENV=
GHC_API_URL=
NEXT_PUBLIC_GHC_API_URL=

# ── Pi Network ────────────────────────────────────────────────────
NEXT_PUBLIC_PI_SANDBOX=true
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=
NEXT_PUBLIC_REQUIRE_PI_BROWSER=
PI_API_KEY=                 # server-only
PI_SERVER_API_KEY=          # server-only (legacy alias)
PI_API_URL=
PI_PLATFORM_API_URL=
PI_WALLET_PRIVATE_SEED=     # server-only, A2U payouts
PI_STAKING_API_ENABLED=false
PI_ALLOW_UNBOUND_APPROVE=false
DOMAIN_VALIDATION_KEY=      # served at /validation-key.txt

# ── Supabase (server-only except the public URL) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=  # server-only
SUPABASE_JWT_SECRET=        # server-only
SUPABASE_DB_URL=            # server-only
DATABASE_URL=               # server-only

# ── Auth / sessions / passkeys ────────────────────────────────────
GHC_AUTH_JWT_SECRET=        # server-only
GHC_ALLOW_DEV_AUTH=false
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=false
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=GreenHaven
WEBAUTHN_ORIGIN=
NEXT_PUBLIC_WEBAUTHN_RP_ID=

# ── Economy / payments / withdrawals ──────────────────────────────
GHC_ADMIN_CREDIT_KEY=       # server-only
GHC_A2U_ADMIN_KEY=          # server-only
GHC_A2U_ALLOW_PARTIAL=false
GH_SETTLEMENT_INTERNAL_KEY= # server-only, GHPV settlement
GH_WITHDRAWAL_OPERATOR_IDS=
GHC_WITHDRAWAL_GHC_PER_PI=
GHC_BUY_WITH_PI_ENABLED=false
NEXT_PUBLIC_GHC_BUY_WITH_PI=false
GHC_ELIGIBLE_ECONOMIC_USERS=
GHC_ALLOW_ELIGIBLE_OVERRIDE=false
GHC_MARKETPLACE_LISTING_FEE_PI=
GHC_MARKETPLACE_LISTING_FEE_BPS=
GH_MARKETPLACE_ATOMIC_RESERVE=false

# ── Feature flags / server modes ──────────────────────────────────
GHC_SERVER_MEMORY=
GHC_VERIFICATION_SERVER=
GHC_GOVERNANCE_SERVER=
GHC_REPUTATION_SERVER=
VERIFICATION_REVIEW_SECRET= # server-only
GH_ADS_ENABLED=false
GH_MEDIA_BUCKET=
NEXT_PUBLIC_MESSAGING_DURABLE=false
NEXT_PUBLIC_GH_REALTIME_URL=
GHC_REALTIME_CONFIGURED=false
NEXT_PUBLIC_GHC_STUDIO=false
NEXT_PUBLIC_DISCOVERY_DEMO=false
