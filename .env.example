# GH-CONNECT environment example — copy to .env.local (never commit secrets)

# --- Application (server) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PI_API_KEY=
# PI_APP_ID=

# --- E2E testing only (not used by the Next.js app at runtime) ---
# Local:
# GHC_E2E_BASE_URL=http://127.0.0.1:3000
# GHC_E2E_ALLOW_LOCALHOST=1
#
# Vercel preview:
# GHC_E2E_BASE_URL=https://your-preview-xxx.vercel.app
#
# Production smoke (explicit opt-in only):
# GHC_E2E_BASE_URL=https://gh-connect-tau.vercel.app
# GHC_E2E_ALLOW_PRODUCTION=1
# GHC_E2E_TARGET=production
#
# GHC_E2E_COOKIE_A=
# GHC_E2E_COOKIE_B=
# GHC_E2E_START_SERVER=1
