# GreenHaven environment template
# Copy to .env.local for local development. Never commit .env.local or real credentials.
# Empty values are intentional placeholders. Configure secrets only in the deployment
# provider's encrypted environment-variable settings, and only for the environments
# that require them.

# Public application configuration (safe to expose only when the value is genuinely public)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GHC_API_URL=
NEXT_PUBLIC_GH_REALTIME_URL=
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=1
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=
NEXT_PUBLIC_REQUIRE_PI_BROWSER=0
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=0
NEXT_PUBLIC_GHC_PI_ONLY_COMMERCE=1
NEXT_PUBLIC_MESSAGING_DURABLE=0

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only infrastructure credentials — NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
GHC_AUTH_JWT_SECRET=
VERIFICATION_REVIEW_SECRET=
DOMAIN_VALIDATION_KEY=
GHC_ADMIN_API_KEY=
GHC_ADMIN_CREDIT_KEY=
GHC_A2U_ADMIN_KEY=
GHC_OPERATOR_RECONCILE_KEY=
GHC_CREATOR_REWARD_OPERATOR_KEY=
GHC_BENEFICIARY_FINGERPRINT_KEY=
GH_SETTLEMENT_INTERNAL_KEY=
GREENHAVEN_ANNOUNCEMENT_ADMIN_KEY=
GHC_SYSTEM_STATUS_OPERATOR_KEY=
GHC_PAYOUT_RECONCILIATION_KEY=
GHC_API_URL=

# Pi Platform credentials (server-side only). Keep payout execution disabled by default.
PI_API_KEY=
PI_SERVER_API_KEY=
PI_WALLET_PRIVATE_SEED=
PI_ENV=
PI_NETWORK=
PI_A2U_ENABLED=0
PI_A2U_TESTNET_ONLY=1
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=0
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
PI_EARNINGS_EXECUTOR_KEY=

# Economy/reward switches — fail closed unless explicitly enabled after review.
GHC_REGISTRATION_BONUS_ENABLED=0
GHC_REFERRAL_SETTLEMENT_ENABLED=0
GHC_CURATION_REDISTRIBUTE_ENABLED=0
GHC_ACTIVITY_REWARDS_ENABLED=0
GHC_BUY_WITH_PI_ENABLED=0
GHC_MARKETPLACE_GHC_PAYOUTS_ENABLED=0
GHC_TIPS_ENABLED=0
GHC_WITHDRAWALS_ENABLED=0
GHC_PAYOUT_RAIL_DISABLED=1
GHC_PI_ONLY_COMMERCE=1
GHC_NOT_ON_PI_RAILS=1
GH_ADS_ENABLED=0

# Operator and integration controls
GHC_VERIFICATION_SERVER=0
GHC_REPUTATION_SERVER=0
GHC_GOVERNANCE_SERVER=0
GHC_SERVER_MEMORY=0
GHC_REALTIME_CONFIGURED=0
GHC_ALLOW_DEV_AUTH=0
GHC_E2E_ALLOW_LOCALHOST=0
GHC_E2E_ALLOW_TESTNET=0
GHC_E2E_ALLOW_PRODUCTION=0
GHC_E2E_TARGET=
GHC_E2E_BASE_URL=
GHC_E2E_COOKIE_A=
GHC_E2E_COOKIE_B=
GHC_E2E_AUTH_A=
GHC_E2E_AUTH_B=
GHC_E2E_MEDIA_URL=
GHC_E2E_PEER_USER_ID_B=
GHC_E2E_CONVERSATION_ID=
GHC_E2E_PRODUCTION_HOSTS=

# PI_NETWORK must be set in deployment (testnet for the currently gated payout flows).
# Do not enable payout execution or configure a wallet seed on a public production
# deployment until the separate security, provider, KYC, and operator release gates pass.

# Withdrawal PIN proof (HMAC key, >=32 random chars). Withdrawals fail closed (503) without it.
GH_PIN_PROOF_SECRET=
