# GreenHaven environment template.
# Copy into a local environment file and fill values from the appropriate
# development/preview/testnet secret manager. Never commit populated secrets.
# Production release flags and private credentials must remain server-side.

# Public application configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PI_SANDBOX=true

# Server-side values are intentionally blank in this template.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PI_API_KEY=
PI_WALLET_PRIVATE_SEED=
PI_EARNINGS_EXECUTOR_KEY=

# Explicitly disabled until a Testnet-only registration-bonus release is approved.
GHC_REGISTRATION_BONUS_ENABLED=0

# Optional server-side operator keys. Keep these out of browser-exposed variables.
GHC_CREATOR_REWARD_OPERATOR_KEY=
GHC_REWARD_OPERATOR_KEY=
GHC_ECONOMY_OPERATOR_KEY=

# Withdrawal capabilities default to disabled. Enable only in approved Testnet.
PI_EARNINGS_PAYOUT_REQUESTS_ENABLED=0
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
PI_A2U_ENABLED=0
PI_A2U_TESTNET_ONLY=true
GH_PIN_PROOF_SECRET=
GHC_REFERRAL_SETTLEMENT_ENABLED=0
GHC_CURATION_REDISTRIBUTE_ENABLED=0
NEXT_PUBLIC_RUM_SAMPLE_RATE=0
