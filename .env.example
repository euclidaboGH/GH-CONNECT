# GREENHAVEN — canonical environment template
# Values below are safe local defaults or blank placeholders. Populate Vercel Preview separately.
# PUBLIC = browser-visible; PRIVATE = server-only. Never expose private values with NEXT_PUBLIC_.

# Public application URLs and browser-visible configuration
# Public application / Pi SDK
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_HOSTED_URL=
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PI_SANDBOX=true
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_RUM_SAMPLE_RATE=0
NEXT_PUBLIC_GHC_TESTNET_UNLOCK=false
NEXT_PUBLIC_GHC_REFERRAL_SETTLEMENT_ENABLED=false
NEXT_PUBLIC_GHC_PI_ONLY_COMMERCE=true
NEXT_PUBLIC_GHC_BUY_WITH_PI=false
NEXT_PUBLIC_GHC_COMMUNITY_CREATE_FEE_PI=
NEXT_PUBLIC_GHC_COMMUNITY_CREATE_FEE_GHC=
NEXT_PUBLIC_GHC_MARKETPLACE_LISTING_FEE_PI=
NEXT_PUBLIC_GHC_MARKETPLACE_LISTING_FEE_GHC=
NEXT_PUBLIC_GHC_CURATION_REDISTRIBUTE_ENABLED=false
NEXT_PUBLIC_MESSAGING_DURABLE=true

# Server-only application and provider configuration
# PI_ENV selects the Pi Platform API mode (production API); PI_NETWORK selects the blockchain network.
# For Testnet, keep PI_NETWORK=testnet and NEXT_PUBLIC_PI_SANDBOX=true. PI_ENV=production is not Mainnet.
# Private Pi Testnet / payout execution
PI_EARNINGS_AUTO_EXECUTE=false
PI_WALLET_PRIVATE_SEED=
PI_EARNINGS_EXECUTOR_KEY=
PI_EARNINGS_PAYOUT_EXECUTION_ENABLED=0
