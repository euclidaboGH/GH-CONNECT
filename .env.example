# Copy to Vercel → Settings → Environment Variables.
# Never commit real secrets. Never put PI_API_KEY in client code.
#
# Release gate: GET /api/health → status must be "ready" on Production
# Full matrix: docs/FOUNDATION_READINESS.md
# GHC persistence: docs/GHC_PRODUCTION_PERSISTENCE.md

# ---------------------------------------------------------------------------
# REQUIRED on Vercel Production (and strongly recommended on Preview)
# ---------------------------------------------------------------------------

# Pi Server API Key (Developer Portal → App → API Key) — SERVER ONLY
# Used for payments approve/complete. NEVER expose via NEXT_PUBLIC_*.
PI_API_KEY=

# Pi Sign-in OAuth Client ID (Developer Portal → Pi Sign-in → oAuth Client ID)
# Public identifier only — no client_secret exists for implicit flow.
NEXT_PUBLIC_PI_CLIENT_ID=

# Authoritative GHC ledger + identity + sessions + payment intents
# Process-local memory is DISABLED on Vercel/production. Without these,
# daily claim, transfers, wallet, sessions, and Pi payment intents return 503.
SUPABASE_URL=
# (or NEXT_PUBLIC_SUPABASE_URL for the URL only — never the service role on public)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional / environment-specific
# ---------------------------------------------------------------------------

# Optional: force sandbox true/false. If unset, auto:
#   localhost + Vercel preview → sandbox true
#   Vercel production → sandbox false
# NEXT_PUBLIC_PI_SANDBOX=true

# Optional: public app origin (redirect URI base). If unset, uses window.location.origin.
# NEXT_PUBLIC_APP_URL=https://your-production-host.example

# Optional: comma-separated hosts treated as production (sandbox false when env unset)
# NEXT_PUBLIC_PI_PRODUCTION_HOSTS=your-production-host.example

# Domain validation (optional if public/validation-key.txt is deployed)
DOMAIN_VALIDATION_KEY=

# Optional alternative DB URL (if not using Supabase REST service role)
# DATABASE_URL=

# Dev-only Bearer user:<id> — NEVER enable in production
# GHC_ALLOW_DEV_AUTH=1

# Optional JWT for first-party API auth (HS256)
# GHC_AUTH_JWT_SECRET=

# LOCAL / unit-test only — in-process GHC ledger when no database is configured.
# IGNORED on Vercel and when NODE_ENV/GHC_ENV is production.
# Do NOT set this on Vercel Production or Preview.
# GHC_SERVER_MEMORY=1

# WebAuthn / Passkeys (Phase 7) — optional additive step-up
# Production MUST set exact RP ID and origin (no mixing preview/prod).
# WEBAUTHN_ENABLED=1
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGIN=https://app.example.com
# WEBAUTHN_RP_NAME=GreenHaven CONNECT
# NEXT_PUBLIC_APP_URL=https://app.example.com
# Set WEBAUTHN_ENABLED=0 to disable passkeys entirely.

# --- Pi Sep 2026 capabilities ---
# Staking Data API (Ecosystem Directory) — leave unset until Pi whitelist grants access.
# PI_STAKING_API_ENABLED=true

# Local storage is client-side (Pi Browser whitelist). No server env required.
# See lib/pi-local-storage.ts — never store tokens / balances there.
