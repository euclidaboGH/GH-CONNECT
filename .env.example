# GreenHaven environment template
# Copy to a private local environment file and fill only values required by the
# deployment. Never commit populated credentials. Production secrets belong in
# the hosting provider's encrypted environment-variable store.

# Public application URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_PI_CLIENT_ID=
NEXT_PUBLIC_PI_SANDBOX=0
NEXT_PUBLIC_REQUIRE_PI_BROWSER=1
NEXT_PUBLIC_ALLOW_LOCAL_AUTH=0
NEXT_PUBLIC_DISCOVERY_DEMO=0
NEXT_PUBLIC_GHC_STUDIO=0
NEXT_PUBLIC_GHC_PI_ONLY_COMMERCE=0
NEXT_PUBLIC_MESSAGING_DURABLE=0
NEXT_PUBLIC_GH_REALTIME_URL=
NEXT_PUBLIC_PI_PRODUCTION_HOSTS=
NEXT_PUBLIC_RUM_SAMPLE_RATE=0
NEXT_PUBLIC_WEBAUTHN_RP_ID=
NEXT_PUBLIC_VERCEL_ENV=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=
GH_MEDIA_BUCKET=
GH_PIN_PROOF_SECRET=

# Server-only Pi Platform configuration — keep network explicitly unset until
# the deployment is intentionally configured and independently reviewed.
PI_API_KEY=
PI_SERVER_API_KEY=
PI_API_URL=
PI_PLATFORM_API_URL=
PI_NETWORK=
PI_ENV=
PI_WALLET_PRIVATE_SEED=
