# Recreated by Vercel during install/build; never upload local caches or dependency trees.
.git
.git/**
node_modules
node_modules/**
.next
.next/**
.cache
.cache/**
.turbo
.turbo/**
.vercel
.vercel/**
coverage
coverage/**
playwright-report
playwright-report/**
test-results
test-results/**
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.zip
*.tar
*.tar.gz
# Vercel deploys only committed Git files. Exclude common local secret files
# explicitly; do not use .env* because Vercel's ignore processing can still
# drop the safe .env.example template required by prebuild verification.
.env
.env.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local
